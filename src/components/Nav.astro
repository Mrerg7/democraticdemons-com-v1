          id="nav-toggle"
          type="button"
          class="md:hidden p-2.5 rounded-xl border border-zinc-800 text-zinc-300 hover:border-zinc-600 transition-colors"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
