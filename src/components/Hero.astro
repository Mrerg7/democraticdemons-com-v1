---
const heroImage =
  'https://imagedelivery.net/-sPAUAWeA405NiWJ0SNIQA/5ebbef5b-5636-4336-5ea9-1ddbf0f8e400/public';
---

<div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 sm:py-16 text-center">
  <div class="inline-flex items-center gap-x-2 px-3 sm:px-4 py-1.5 rounded-3xl bg-zinc-900 border border-zinc-800 mb-6 max-w-full">
    <div class="w-2 h-2 shrink-0 bg-red-600 rounded-full animate-pulse"></div>
    <span class="text-[10px] sm:text-xs font-mono tracking-[2px] sm:tracking-[3px] text-red-500 font-semibold">2016 — 2026 • THE DEMONIC DECADE</span>
  </div>

  <h1 class="heading-font text-4xl sm:text-5xl md:text-7xl lg:text-8xl font-semibold tracking-tighter leading-[0.95] sm:leading-none mb-4">
    THE DEMONS<br />DON'T PERFORM.<br />THEY <span class="text-red-600">CONJURE</span>.
  </h1>

  <p class="max-w-2xl mx-auto text-lg sm:text-xl md:text-2xl text-zinc-400 font-light tracking-tight mb-8 sm:mb-10 px-2">
    When they speak, smell the sulfur.<br />
    <span class="text-red-500">Bet the opposite — or burn.</span>
  </p>

  <img
    src={heroImage}
    alt="Democratic Demons"
    width="1200"
    height="675"
    class="w-full max-w-3xl mx-auto rounded-2xl sm:rounded-3xl border border-zinc-800 shadow-2xl shadow-red-950/20"
    loading="eager"
    decoding="async"
  />

  <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 sm:gap-x-4 mt-8 sm:mt-10 px-2 sm:px-0">
    <a href="#mammon"
       class="px-6 sm:px-8 py-4 bg-white text-black font-semibold rounded-3xl text-sm flex items-center justify-center gap-x-3 hover:bg-zinc-200 transition-all active:scale-[0.985]">
      <span>ENTER THE INFERNAL RECORD</span>
      <i class="fa-solid fa-arrow-down"></i>
    </a>
    <a href="#exorcism"
       class="px-6 sm:px-8 py-4 border border-zinc-700 hover:border-red-600 font-semibold rounded-3xl text-sm flex items-center justify-center gap-x-3 transition-all">
      <span>TESTIFY</span>
    </a>
  </div>

  <div class="mt-6 text-[10px] font-mono tracking-widest text-zinc-500 px-4">
    NOT PARTISAN THEATER. PURE CORROSIVE TRUTH.
  </div>
</div>
